% The subject's name, set as the title.
% from acme_cards.Name (body: name.tex)
\newcommand{\acName}[1]{%
\par\noindent{\Large\bfseries #1}\par
}

% One short sentence under the title.
% from acme_cards.Fact (body: fact.tex)
\newcommand{\acFact}[1]{%
\par\noindent #1\par\vspace{2mm}
}

% A labelled paragraph; the label prints as its heading.
% from acme_cards.Slot (body: slot.tex)
\newcommand{\acSlot}[2][]{%
\par\noindent
\ifx\relax#1\relax\else{\bfseries #1\quad}\fi
#2\par
}

% A thin horizontal rule.
% from acme_cards.Rule (body: inline)
\newcommand{\acRule}{%
\par\noindent\rule{\linewidth}{0.4pt}\par
}
